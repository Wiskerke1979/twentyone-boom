# Database — SQLite voor dev, switch naar postgresql:// voor productie
DATABASE_URL="file:./dev.db"

# NextAuth — genereer een secret met: openssl rand -base64 32
AUTH_SECRET="your-secret-here-replace-me"
AUTH_TRUST_HOST=true

# App URL — gebruikt in email-links
NEXTAUTH_URL="http://localhost:3000"

# Resend (e-mail) — optioneel voor dev (alles wordt naar console gelogd als deze leeg is)
# Maak gratis account op resend.com en plak hier de API key
RESEND_API_KEY=""
EMAIL_FROM="De Groeiende Boom <noreply@example.com>"
SUPPORT_EMAIL=""

# S3 / R2 / S3-compatible storage voor bewijs-bestanden (anders lokaal in public/uploads)
# Aanbevolen voor productie: Cloudflare R2 (gratis 10GB, EU regio)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                              # bv. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""                            # public CDN url, of leeg = signed URLs gebruiken
